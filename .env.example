# Used by docker-compose.yml at startup
# Copy to .env in this directory and edit.

# Shared secret used by all services to sign/verify JWTs.
# IMPORTANT: change this in production. Generate with: openssl rand -hex 64
JWT_SECRET=change_this_to_a_random_secret_key

# Stripe (optional — leave blank for demo/mock mode).
# Get keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
